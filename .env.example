# Copia este archivo a .env y cambia SECRET_KEY antes de desplegar.
SECRET_KEY=change-me

# Ruta de instance dentro del contenedor Docker.
FLASK_INSTANCE_PATH=/app/instance

# Puerto publicado en la máquina anfitriona.
HOST_PORT=8000

# Gunicorn. Mantener 1 worker evita duplicar workers internos de la app
# y reduce bloqueos con SQLite. La concurrencia HTTP se da con threads.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info

# Datos demo.
LOAD_DEMO_DATA=true

# Worker de procesamiento de colecciones.
# En Docker producción el servicio web fuerza AUTO_START_TRACE_WORKER=false
# y el servicio worker arranca el procesamiento explícitamente.
AUTO_START_TRACE_WORKER=false
TRACE_WORKER_CONCURRENCY=1
TRACE_WORKER_POLL_SECONDS=2.0
TRACE_WORKER_BATCH_SIZE=1
TRACE_WORKER_STALE_SECONDS=600
COLLECTION_PHOTO_RETRY_ENABLE_SECONDS=120

# Inferencia.
SEG_USE_GPU=true
MODEL_VALIDATION_USE_GPU=true
MODEL_VALIDATION_IMAGE_SIZE=128
SEG_DEFAULT_ACTIVE_FOLD=fold.0
SEG_MODEL_TEMPLATE=fold.{fold}
SEG_N_FOLDS=10

# Límites de subida en bytes.
IMAGE_UPLOAD_MAX_CONTENT_LENGTH=16777216
MODEL_UPLOAD_MAX_CONTENT_LENGTH=2147483648

# Cookies.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
